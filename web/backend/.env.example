# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=change-me-to-a-long-random-string
# Where uploaded PDFs and extracted figures are kept (relative to web/backend unless absolute)
STORAGE_DIR=storage
# Verifier settings. The config path is relative to the repository root.
VERIFIER_CONFIG=configs/exp/local_real.yaml
VERIFIER_POLICY=informed
# rule = regex parser only (no model for parsing); agent = rules first, LLM when needed
VERIFIER_PARSER=agent
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Optional: run Qwen and DePlot on a model server instead of this machine (see web/model_server/README.md).
# CCV_REMOTE_URL=https://example.trycloudflare.com
# CCV_REMOTE_KEY=the SERVER_KEY the model server was started with
