2_s0","report_id":"dev_012","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"dev_012_s1","report_id":"dev_012","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_012_s2","report_id":"dev_012","text":"The dataset was split into 80 percent training data and the rest for testing.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_012_s3","report_id":"dev_012","text":"We trained each model for 30 epochs with a batch size of 128.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_012_s4","report_id":"dev_012","text":"Figure 1 shows the test accuracy of DistilBERT by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_012_s5","report_id":"dev_012","text":"DistilBERT achieves 66% test accuracy on Fashion-MNIST.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_012_s6","report_id":"dev_012","text":"DistilBERT scores 54.0 points higher on AG News than on Fashion-MNIST.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_012_s7","report_id":"dev_012","text":"DistilBERT scores 10.6 points higher on SST-2 than on AG News (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_012_s8","report_id":"dev_012","text":"DistilBERT scores 59.7 points higher on CIFAR-10 than on SVHN (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_012_s9","report_id":"dev_012","text":"Figure 2 shows the accuracy by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_012_s10","report_id":"dev_012","text":"As shown in Figure 2, on CIFAR-10, CNN is 6 points better than Transformer.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_012_s11","report_id":"dev_012","text":"ResNet-18 reaches 57.1% accuracy on SST-2.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_012_s12","report_id":"dev_012","text":"On AG News, ResNet-18 is about 7 points better than Transformer.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_012_s13","report_id":"dev_012","text":"ResNet-18 reaches 56.7% accuracy on AG News.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_012_s14","report_id":"dev_012","text":"Figure 3 shows the training loss.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"dev_012_s15","report_id":"dev_012","text":"ResNet-18 has a loss of about 0.5 at epoch 30.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_012_s16","report_id":"dev_012","text":"As shown in Figure 3, Ours has a loss of 0.729 at epoch 30.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_012_s17","report_id":"dev_012","text":"At epoch 50, the loss of ResNet-18 is 0.456.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_012_s18","report_id":"dev_012","text":"Figure 4 shows the training loss.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_012_s19","report_id":"dev_012","text":"At epoch 10, the loss of VGG-16 is 1.186.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"dev_012_s20","report_id":"dev_012","text":"At epoch 2, the loss of Baseline is 1.61.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"dev_012_s21","report_id":"dev_012","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}