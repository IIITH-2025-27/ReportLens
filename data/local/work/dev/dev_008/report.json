d":null},{"sentence_id":"dev_008_s1","report_id":"dev_008","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_008_s2","report_id":"dev_008","text":"All experiments were run on a single GPU with 16 GB of memory.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_008_s3","report_id":"dev_008","text":"Each experiment was repeated 5 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_008_s4","report_id":"dev_008","text":"Figure 1 shows the f1 score of MobileNet by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"dev_008_s5","report_id":"dev_008","text":"On SST-2, MobileNet obtains a F1 score of 61.4%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_008_s6","report_id":"dev_008","text":"On MNIST, MobileNet obtains a F1 score of 54% (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_008_s7","report_id":"dev_008","text":"Figure 2 shows the validation accuracy by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"dev_008_s8","report_id":"dev_008","text":"Baseline outperforms ViT-S by 4 percentage points on IMDB (Figure 2).","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_008_s9","report_id":"dev_008","text":"As shown in Figure 2, on SST-2, ViT-S obtains a validation accuracy of 85.0%.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_008_s10","report_id":"dev_008","text":"As shown in Figure 2, on CIFAR-10, ViT-S obtains a validation accuracy of 83.5%.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_008_s11","report_id":"dev_008","text":"ViT-S reaches 80.5% validation accuracy on Fashion-MNIST.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"dev_008_s12","report_id":"dev_008","text":"Figure 3 shows the training loss.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"dev_008_s13","report_id":"dev_008","text":"CNN has a loss of about 0.5 at epoch 10.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_008_s14","report_id":"dev_008","text":"CNN has a loss of 0.46 at epoch 10 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_008_s15","report_id":"dev_008","text":"CNN has a loss of 0.634 at epoch 6.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_008_s16","report_id":"dev_008","text":"Figure 4 shows the training loss.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"dev_008_s17","report_id":"dev_008","text":"At epoch 16, the loss of DistilBERT is 0.218.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"dev_008_s18","report_id":"dev_008","text":"Ours has a loss of 0.56 at epoch 18.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"dev_008_s19","report_id":"dev_008","text":"As shown in Figure 4, ResNet-50 has a loss of over 0.2 at epoch 24.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"dev_008_s20","report_id":"dev_008","text":"At epoch 4, the loss of Ours is 1.897.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"dev_008_s21","report_id":"dev_008","text":"Logistic Regression reaches 80.1% accuracy on MNIST.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"dev_008_s22","report_id":"dev_008","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}