,{"sentence_id":"calib_004_s1","report_id":"calib_004","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_004_s2","report_id":"calib_004","text":"Each experiment was repeated 3 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_004_s3","report_id":"calib_004","text":"We trained each model for 20 epochs with a batch size of 64.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_004_s4","report_id":"calib_004","text":"Figure 1 shows the f1 score by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_004_s5","report_id":"calib_004","text":"On MNIST, CNN obtains a F1 score of 93.4%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_004_s6","report_id":"calib_004","text":"On Fashion-MNIST, CNN is about 7 points better than EfficientNet.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_004_s7","report_id":"calib_004","text":"CNN reaches 68.7% F1 score on Fashion-MNIST (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_004_s8","report_id":"calib_004","text":"Figure 2 shows the validation accuracy during training.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_004_s9","report_id":"calib_004","text":"At epoch 6, BERT-base achieves 58.5% validation accuracy (Figure 2).","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_004_s10","report_id":"calib_004","text":"As shown in Figure 2, CNN reaches 65.2% validation accuracy at epoch 14.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_004_s11","report_id":"calib_004","text":"As shown in Figure 2, Ours outperforms CNN by 20.5 percentage","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_004_s12","report_id":"calib_004","text":"points at epoch 30.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"calib_004_s13","report_id":"calib_004","text":"Figure 3 shows the f1 score by dataset.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"calib_004_s14","report_id":"calib_004","text":"DistilBERT outperforms BERT-base by 17.0 percentage points on CIFAR-10 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_004_s15","report_id":"calib_004","text":"Baseline achieves 136.2% F1 score on SVHN (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_004_s16","report_id":"calib_004","text":"On CIFAR-10, ViT-S is 7.5 points better than Baseline.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_004_s17","report_id":"calib_004","text":"ViT-S outperforms BERT-base by 24.2 percentage points on AG News (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_004_s18","report_id":"calib_004","text":"Figure 4 shows the f1 score during training.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_004_s19","report_id":"calib_004","text":"At epoch 2, Baseline achieves 78.3% F1 score.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"calib_004_s20","report_id":"calib_004","text":"At epoch 2, Baseline achieves 54.0% F1 score.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"calib_004_s21","report_id":"calib_004","text":"From epoch 6 to epoch 8, the F1 score of Baseline improves by a relative 5.5% (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"calib_004_s22","report_id":"calib_004","text":"Logistic Regression reaches 65.6% accuracy on IMDB.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"calib_004_s23","report_id":"calib_004","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}