est_figure_id":null},{"sentence_id":"calib_001_s4","report_id":"calib_001","text":"Figure 1 shows the f1 score by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_001_s5","report_id":"calib_001","text":"On SVHN, VGG-16 obtains a F1 score of 83.2%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_001_s6","report_id":"calib_001","text":"As shown in Figure 1, BERT-base outperforms ViT-S by about 3 percentage points on SST-2.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_001_s7","report_id":"calib_001","text":"Figure 2 shows the accuracy during training.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_001_s8","report_id":"calib_001","text":"BERT-base outperforms ResNet-18 by 17.9 percentage points at epoch 2 (Figure 2).","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_001_s9","report_id":"calib_001","text":"As shown in Figure 2, from epoch 8 to epoch 9, the accuracy of EfficientNet improves by a relative 5%.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_001_s10","report_id":"calib_001","text":"Figure 3 shows the validation accuracy of ViT-S by dataset.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"calib_001_s11","report_id":"calib_001","text":"As shown in Figure 3, ViT-S achieves 80.3% validation accuracy on Fashion-MNIST.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_001_s12","report_id":"calib_001","text":"On Fashion-MNIST, ViT-S obtains a validation accuracy of 68.3%.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_001_s13","report_id":"calib_001","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig3"}]}