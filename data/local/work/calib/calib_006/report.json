,"ViT-S","GEAT-base","MobdeNet","2","10","18","26","34"],"y_span":67.20741135697139}],"sentences":[{"sentence_id":"calib_006_s0","report_id":"calib_006","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"calib_006_s1","report_id":"calib_006","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_006_s2","report_id":"calib_006","text":"All experiments were run on a single GPU with 16 GB of memory.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_006_s3","report_id":"calib_006","text":"Each experiment was repeated 5 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_006_s4","report_id":"calib_006","text":"Figure 1 shows the validation accuracy by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"calib_006_s5","report_id":"calib_006","text":"On SST-2, LSTM is 13.4 points better than Baseline (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_006_s6","report_id":"calib_006","text":"Baseline achieves over 65% validation accuracy on SVHN.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_006_s7","report_id":"calib_006","text":"On MNIST, Baseline is 10.7 points better than Transformer.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_006_s8","report_id":"calib_006","text":"Figure 2 shows the training loss.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"calib_006_s9","report_id":"calib_006","text":"LSTM has a loss of 1.556 at epoch 5.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_006_s10","report_id":"calib_006","text":"At epoch 11, the loss of BERT-base is 0.272.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_006_s11","report_id":"calib_006","text":"Figure 3 shows the validation accuracy by dataset.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"calib_006_s12","report_id":"calib_006","text":"On SVHN, EfficientNet obtains a validation accuracy of about 60% (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_006_s13","report_id":"calib_006","text":"On IMDB, EfficientNet obtains a validation accuracy of 88.4%.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_006_s14","report_id":"calib_006","text":"DistilBERT outperforms EfficientNet by 25.3 percentage points on SVHN.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_006_s15","report_id":"calib_006","text":"Figure 4 shows the accuracy during training.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"calib_006_s16","report_id":"calib_006","text":"From epoch 6 to epoch 16, the accuracy of BERT-base improves by a relative about 20%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"calib_006_s17","report_id":"calib_006","text":"ResNet-50 reaches 93.5% accuracy at epoch 40.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"calib_006_s18","report_id":"calib_006","text":"From epoch 18 to epoch 30, the accuracy of ViT-S improves by a relative 19.5%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"calib_006_s19","report_id":"calib_006","text":"Overall, the results are in line with what we expected from the literature.","page":1,"nearest_figure_id":"fig4"}]}