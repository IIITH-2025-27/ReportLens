VGG-16","2","6","10","14","18","22","26"],"y_span":40.68827059748658}],"sentences":[{"sentence_id":"test_012_s0","report_id":"test_012","text":"Lab Report: Model comparison on benchmarks","page":0,"nearest_figure_id":null},{"sentence_id":"test_012_s1","report_id":"test_012","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"test_012_s2","report_id":"test_012","text":"We trained each model for 30 epochs with a batch size of 128.","page":0,"nearest_figure_id":null},{"sentence_id":"test_012_s3","report_id":"test_012","text":"All experiments were run on a single GPU with 16 GB of memory.","page":0,"nearest_figure_id":null},{"sentence_id":"test_012_s4","report_id":"test_012","text":"Figure 1 shows the test accuracy during training.","page":0,"nearest_figure_id":null},{"sentence_id":"test_012_s5","report_id":"test_012","text":"As shown in Figure 1, at epoch 8, EfficientNet is 5.4 points better than ViT-S.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_012_s6","report_id":"test_012","text":"From epoch 4 to epoch 6, the test accuracy of ViT-S improves by a relative 3.9%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_012_s7","report_id":"test_012","text":"Transformer attains a test accuracy of 68.3% at epoch 12.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_012_s8","report_id":"test_012","text":"As shown in Figure 1, Transformer reaches 67.6% test accuracy at epoch 14.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_012_s9","report_id":"test_012","text":"Figure 2 shows the test accuracy by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_012_s10","report_id":"test_012","text":"On SST-2, MobileNet is 46.4 points better than ResNet-18.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"test_012_s11","report_id":"test_012","text":"MobileNet outperforms ResNet-18 by about 6 percentage points on CIFAR-10 (Figure 2).","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"test_012_s12","report_id":"test_012","text":"On SST-2, CNN obtains a test accuracy of 95.8% (Figure 2).","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"test_012_s13","report_id":"test_012","text":"Figure 3 shows the test accuracy of CNN by dataset.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"test_012_s14","report_id":"test_012","text":"CNN scores 12.5 points higher on Fashion-MNIST than on AG News (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_012_s15","report_id":"test_012","text":"CNN achieves 55.6% test accuracy on AG News (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_012_s16","report_id":"test_012","text":"Figure 4 shows the f1 score during training.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_012_s17","report_id":"test_012","text":"At epoch 14, ResNet-18 achieves 84.6% F1 score.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"test_012_s18","report_id":"test_012","text":"At epoch 20, VGG-16 achieves 73.3% F1 score (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"test_012_s19","report_id":"test_012","text":"DistilBERT reaches 65% F1 score at epoch 8.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"test_012_s20","report_id":"test_012","text":"At epoch 12, VGG-16 is 2.1 points better than DistilBERT (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"test_012_s21","report_id":"test_012","text":"We note that the training was stable for all models.","page":2,"nearest_figure_id":"fig4"}]}