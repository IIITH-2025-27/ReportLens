998393}],"sentences":[{"sentence_id":"test_005_s0","report_id":"test_005","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"test_005_s1","report_id":"test_005","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"test_005_s2","report_id":"test_005","text":"All experiments were run on a single GPU with 16 GB of memory.","page":0,"nearest_figure_id":null},{"sentence_id":"test_005_s3","report_id":"test_005","text":"Each experiment was repeated 3 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"test_005_s4","report_id":"test_005","text":"Figure 1 shows the accuracy during training.","page":0,"nearest_figure_id":null},{"sentence_id":"test_005_s5","report_id":"test_005","text":"ResNet-50 reaches 60.4% accuracy at epoch 2 (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_005_s6","report_id":"test_005","text":"As shown in Figure 1, CNN reaches about 70% accuracy at epoch 13.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_005_s7","report_id":"test_005","text":"CNN reaches 45.2% accuracy at epoch 2.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_005_s8","report_id":"test_005","text":"At epoch 6, ResNet-50 is 15.9 points better than DistilBERT.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_005_s9","report_id":"test_005","text":"Figure 2 shows the accuracy of BERT-base by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_005_s10","report_id":"test_005","text":"BERT-base scores 4.0 points higher on AG News than on IMDB.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"test_005_s11","report_id":"test_005","text":"As shown in Figure 2, BERT-base scores 67.1 points higher on AG News than on SST-2.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"test_005_s12","report_id":"test_005","text":"As shown in Figure 2, BERT-base achieves 87% accuracy on Fashion-MNIST.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"test_005_s13","report_id":"test_005","text":"BERT-base reaches 71.3% accuracy on SVHN.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"test_005_s14","report_id":"test_005","text":"Figure 3 shows the test accuracy of ResNet-18 by dataset.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"test_005_s15","report_id":"test_005","text":"As shown in Figure 3, ResNet-18 scores 55.8 points higher on AG News than on SVHN.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_005_s16","report_id":"test_005","text":"ResNet-18 reaches 73.0% test accuracy on MNIST (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_005_s17","report_id":"test_005","text":"Figure 4 shows the validation accuracy by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_005_s18","report_id":"test_005","text":"On SST-2, MobileNet obtains a validation accuracy of 67.8%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"test_005_s19","report_id":"test_005","text":"On Fashion-MNIST, MobileNet is 2.8 points better than Baseline (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"test_005_s20","report_id":"test_005","text":"XGBoost reaches 50.2% accuracy on AG News.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"test_005_s21","report_id":"test_005","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}