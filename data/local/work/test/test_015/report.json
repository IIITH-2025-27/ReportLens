15_s0","report_id":"test_015","text":"Lab Report: Comparing CNN architectures","page":0,"nearest_figure_id":null},{"sentence_id":"test_015_s1","report_id":"test_015","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"test_015_s2","report_id":"test_015","text":"Each experiment was repeated 3 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"test_015_s3","report_id":"test_015","text":"The learning rate was set to 0.01 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"test_015_s4","report_id":"test_015","text":"Figure 1 shows the validation accuracy during training.","page":0,"nearest_figure_id":null},{"sentence_id":"test_015_s5","report_id":"test_015","text":"As shown in Figure 1, Ours outperforms GRU by 13.3 percentage points at epoch 6.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_015_s6","report_id":"test_015","text":"GRU reaches 69% validation accuracy at epoch 4.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_015_s7","report_id":"test_015","text":"GRU reaches 61.9% validation accuracy at epoch 2.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_015_s8","report_id":"test_015","text":"Figure 2 shows the validation accuracy of Transformer by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"test_015_s9","report_id":"test_015","text":"Transformer reaches 34.9% validation accuracy on AG News.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"test_015_s10","report_id":"test_015","text":"As shown in Figure 2, Transformer reaches 70.1% validation accuracy on SST-2.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"test_015_s11","report_id":"test_015","text":"Figure 3 shows the accuracy by dataset.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"test_015_s12","report_id":"test_015","text":"VGG-16 outperforms EfficientNet by 13.6 percentage points on MNIST (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_015_s13","report_id":"test_015","text":"VGG-16 achieves 33.7% accuracy on AG News.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_015_s14","report_id":"test_015","text":"EfficientNet reaches 79.2% accuracy on Fashion-MNIST.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_015_s15","report_id":"test_015","text":"Figure 4 shows the accuracy of ViT-S by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_015_s16","report_id":"test_015","text":"As shown in Figure 4, ViT-S reaches 91.0% accuracy on CIFAR-10.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"test_015_s17","report_id":"test_015","text":"On CIFAR-10, ViT-S obtains a accuracy of 62.5%.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"test_015_s18","report_id":"test_015","text":"ViT-S scores 20.6 points higher on Fashion-MNIST than on MNIST.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"test_015_s19","report_id":"test_015","text":"ViT-S achieves 65.4% accuracy on SST-2 (Figure 4).","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"test_015_s20","report_id":"test_015","text":"On Fashion-MNIST, XGBoost obtains an accuracy of 64.5%.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"test_015_s21","report_id":"test_015","text":"Overall, the results are in line with what we expected from the literature.","page":2,"nearest_figure_id":"fig4"}]}