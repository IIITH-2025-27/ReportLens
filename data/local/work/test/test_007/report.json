d":"fig3"},{"sentence_id":"test_007_s16","report_id":"test_007","text":"From epoch 1 to epoch 3, the validation accuracy of ResNet-18 improves by a relative about 10% (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_007_s17","report_id":"test_007","text":"Naive Bayes reaches 61.0% accuracy on Tiny-ImageNet.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"test_007_s18","report_id":"test_007","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig3"}]}