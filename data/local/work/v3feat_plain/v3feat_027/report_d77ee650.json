{"report_id":"v3feat_027","pdf_path":"data/local/generated/v3feat_plain/v3feat_027/report.pdf","figures":[{"figure_id":"fig1","report_id":"v3feat_027","image_path":"data/local/work/v3feat_plain/v3feat_027/p0_x11.png","caption":"Accuracy during training","number":1,"chart_type":"line","page":0,"text_lines":["Accuracy during training","2.50","80","2.25","78","2.00","76","1.75","&","74",">","ResNet-18","==","1.50 E","72","4","1.25","70","1.00","68","0.75","66","0.50","10","15","20","25","Epoch","ResNet-18","5","10","20","25"],"y_span":15.903431043939264,"panel":null,"y_range":[65.20372966055211,81.10716070449138],"flags":["dual_y"]},{"figure_id":"fig2","report_id":"v3feat_027","image_path":"data/local/work/v3feat_plain/v3feat_027/p1_x21.png","caption":"Test accuracy of VGG-16 by dataset","number":2,"chart_type":"line","page":1,"text_lines":["Test accuracy","of VGG-16 by","dataset","75","70","65","60","55","IMDB","SS 1-2","IMDB","SS1-2"],"y_span":23.7281187501344,"panel":null,"y_range":[52.694175931700386,76.42229468183479],"flags":[]}],"sentences":[{"sentence_id":"v3feat_027_s0","report_id":"v3feat_027","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_027_s1","report_id":"v3feat_027","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_027_s2","report_id":"v3feat_027","text":"The dataset was split into 80 percent training data and the rest for testing.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_027_s3","report_id":"v3feat_027","text":"All experiments were run on a single GPU with 12 GB of memory.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_027_s4","report_id":"v3feat_027","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_027_s5","report_id":"v3feat_027","text":"From epoch 10 to epoch 15, the accuracy of ResNet-18 improves by a relative 6%.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_027_s6","report_id":"v3feat_027","text":"ResNet-18 scores 4.6 points higher on 15 than on 10.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_027_s7","report_id":"v3feat_027","text":"ResNet-18 reaches 72.4% accuracy at epoch 25 (Figure 1).","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_027_s8","report_id":"v3feat_027","text":"At epoch 25, the loss of ResNet-18 is 0.578.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_027_s9","report_id":"v3feat_027","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_027_s10","report_id":"v3feat_027","text":"As shown in Figure 2, VGG-16 scores 15.4 points higher on SST-2 than on IMDB.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_027_s11","report_id":"v3feat_027","text":"On IMDB, VGG-16 obtains a test accuracy of 51.4% (Figure 2).","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_027_s12","report_id":"v3feat_027","text":"XGBoost reaches 64.0% accuracy on Yelp.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_027_s13","report_id":"v3feat_027","text":"Overall, the results are in line with what we expected from the literature.","page":1,"nearest_figure_id":"fig2","figure_id":null}]}