5","—e—","EfficientNet","ResNet-50","Se","0.75","60","——> CNN","ResNetas.","—@—","0.50","10","15","20","25","Epoch","EfficientNet","ResNet-50","CNN","ResNetags",".","10","15","20","25"],"y_span":37.04495672049271,"panel":null,"y_range":[55.07646663562674,92.12142335611945],"flags":["dual_y"]}],"sentences":[{"sentence_id":"v3feat_001_s0","report_id":"v3feat_001","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_001_s1","report_id":"v3feat_001","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_001_s2","report_id":"v3feat_001","text":"Each experiment was repeated 5 times with different random seeds.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_001_s3","report_id":"v3feat_001","text":"The dataset was split into 80 percent training data and the rest for testing.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_001_s4","report_id":"v3feat_001","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_001_s5","report_id":"v3feat_001","text":"MobileNet achieves over 80% F1 score on AG News (Figure 3).","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_001_s6","report_id":"v3feat_001","text":"MobileNet achieves 75% F1 score on IMDB, while MobileNet obtains 75.1% F1 score on Fashion-MNIST.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_001_s7","report_id":"v3feat_001","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_001_s8","report_id":"v3feat_001","text":"EfficientNet reaches 86.1% accuracy on SST-2.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_001_s9","report_id":"v3feat_001","text":"VGG-16 scores 1.1 points higher on MNIST than on SST-2.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_001_s10","report_id":"v3feat_001","text":"Figure 3 shows the results of this experiment.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_001_s11","report_id":"v3feat_001","text":"On MNIST, VGG-16 obtains a accuracy of 89.3%.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_001_s12","report_id":"v3feat_001","text":"Figure 4 shows the results of this experiment.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_001_s13","report_id":"v3feat_001","text":"ResNet-50 outperforms ResNet-18 by 5.4 percentage points at epoch 15.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_001_s14","report_id":"v3feat_001","text":"As shown in Figure 4, CNN reaches 64.3% test accuracy at epoch 20.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_001_s15","report_id":"v3feat_001","text":"At epoch 10, ResNet-50 is about 17 points better than CNN.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_001_s16","report_id":"v3feat_001","text":"At epoch 25, the loss of EfficientNet is 0.501.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_001_s17","report_id":"v3feat_001","text":"Overall, the results are in line with what we expected from the literature.","page":2,"nearest_figure_id":"fig4","figure_id":null}]}