"0.2","0.1","0.05","1","2","3","4","=","6","7","8","9","Epoch","Ours","MobileNet","1","2","3","5","6","7","8","9"],"y_span":3.544430657411521,"panel":null,"y_range":[0.037318839474960126,3.581749496886481],"flags":["log_y"]}],"sentences":[{"sentence_id":"v3feat_007_s0","report_id":"v3feat_007","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_007_s1","report_id":"v3feat_007","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_007_s2","report_id":"v3feat_007","text":"The learning rate was set to 0.0003 with the Adam optimizer.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_007_s3","report_id":"v3feat_007","text":"All experiments were run on a single GPU with 12 GB of memory.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_007_s4","report_id":"v3feat_007","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_007_s5","report_id":"v3feat_007","text":"GRU reaches 56.0% F1 score at epoch 10 (Figure 1).","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_007_s6","report_id":"v3feat_007","text":"As shown in Figure 1, ResNet-18 attains a F1 score of over 50% at epoch 10.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_007_s7","report_id":"v3feat_007","text":"At epoch 60, the loss of Baseline is 0.460.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_007_s8","report_id":"v3feat_007","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_007_s9","report_id":"v3feat_007","text":"As shown in Figure 2, LSTM reaches 79.7% accuracy on SST-2.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_007_s10","report_id":"v3feat_007","text":"MLP scores 23.1 points higher on MNIST than on SVHN.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_007_s11","report_id":"v3feat_007","text":"Figure 3 shows the results of this experiment.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_007_s12","report_id":"v3feat_007","text":"As shown in Figure 3, MLP achieves 77.6% accuracy on Fashion-MNIST.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_007_s13","report_id":"v3feat_007","text":"LSTM achieves 68.4% accuracy on Fashion-MNIST.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_007_s14","report_id":"v3feat_007","text":"Figure 4 shows the results of this experiment.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_007_s15","report_id":"v3feat_007","text":"Ours has a loss of over 1.0 at epoch 3 (Figure 3).","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_007_s16","report_id":"v3feat_007","text":"Ours has a loss of about 2.9 at epoch 1.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_007_s17","report_id":"v3feat_007","text":"At epoch 9, Ours reaches its maximum loss of 0.046.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_007_s18","report_id":"v3feat_007","text":"XGBoost reaches 70.7% accuracy on CIFAR-10.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_007_s19","report_id":"v3feat_007","text":"Overall, the results are in line with what we expected from the literature.","page":2,"nearest_figure_id":"fig4","figure_id":null}]}