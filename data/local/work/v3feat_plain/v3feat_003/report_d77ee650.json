"BERT-base","AG News","IMDB","Fashion-MNIST","Dataset","MLP","Ours","BERT-base","AGNews","IMDB","Fashion-MNIST"],"y_span":94.6157605061468,"panel":null,"y_range":[-0.02018929067436659,94.59557121547243],"flags":[]}],"sentences":[{"sentence_id":"v3feat_003_s0","report_id":"v3feat_003","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_003_s1","report_id":"v3feat_003","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_003_s2","report_id":"v3feat_003","text":"We trained each model for 20 epochs with a batch size of 32.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_003_s3","report_id":"v3feat_003","text":"The dataset was split into 70 percent training data and the rest for testing.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_003_s4","report_id":"v3feat_003","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_003_s5","report_id":"v3feat_003","text":"As shown in Figure 4, from epoch 40 to epoch 70, the F1 score of EfficientNet improves by a relative 0.7%.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_003_s6","report_id":"v3feat_003","text":"EfficientNet reaches 94.0% F1 score at epoch 70 (Figure 1(a)).","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_003_s7","report_id":"v3feat_003","text":"At epoch 70, EfficientNet is 10.0 points better than DistilBERT (Figure 1(a)).","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_003_s8","report_id":"v3feat_003","text":"GRU attains a validation accuracy of 68.1% at epoch 15.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_003_s9","report_id":"v3feat_003","text":"GRU reaches 84% validation accuracy at epoch 45 and 65.9% at epoch 15.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_003_s10","report_id":"v3feat_003","text":"The validation accuracy of GRU reaches its highest value of 84.3% at epoch 45.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_003_s11","report_id":"v3feat_003","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_003_s12","report_id":"v3feat_003","text":"On SST-2, Ours obtains a accuracy of 40.6%.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_003_s13","report_id":"v3feat_003","text":"MLP scores 15.0 points higher on IMDB than on SST-2.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_003_s14","report_id":"v3feat_003","text":"Figure 3 shows the results of this experiment.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_003_s15","report_id":"v3feat_003","text":"BERT-base outperforms Ours by 6 percentage points on AG News.","page":2,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_003_s16","report_id":"v3feat_003","text":"Random Forest reaches 52.7% accuracy on Tiny-ImageNet.","page":2,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_003_s17","report_id":"v3feat_003","text":"Overall, the results are in line with what we expected from the literature.","page":2,"nearest_figure_id":"fig3","figure_id":null}]}