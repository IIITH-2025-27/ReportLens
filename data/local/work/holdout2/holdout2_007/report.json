e_id":null},{"sentence_id":"holdout2_007_s3","report_id":"holdout2_007","text":"The learning rate was set to 0.001 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_007_s4","report_id":"holdout2_007","text":"Figure 1 shows the training loss.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_007_s5","report_id":"holdout2_007","text":"At epoch 10, the loss of ViT-S is 0.734.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_007_s6","report_id":"holdout2_007","text":"CNN has a loss of 0.667 at epoch 12 (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_007_s7","report_id":"holdout2_007","text":"As shown in Figure 1, at epoch 8, the loss of CNN is about 0.8.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_007_s8","report_id":"holdout2_007","text":"VGG-16 has a loss of 1.182 at epoch 16.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_007_s9","report_id":"holdout2_007","text":"Figure 2 shows the f1 score of DistilBERT by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_007_s10","report_id":"holdout2_007","text":"DistilBERT achieves 72.3% F1 score on SST-2.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_007_s11","report_id":"holdout2_007","text":"On CIFAR-10, DistilBERT obtains a F1 score of 84.1% (Figure 2).","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_007_s12","report_id":"holdout2_007","text":"Figure 3 shows the test accuracy during training.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_007_s13","report_id":"holdout2_007","text":"From epoch 2 to epoch 6, the test accuracy of LSTM improves by a relative 27.8% (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_007_s14","report_id":"holdout2_007","text":"LSTM attains a test accuracy of 83.3% at epoch 8 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_007_s15","report_id":"holdout2_007","text":"LSTM reaches 61.3% test accuracy at epoch 12.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_007_s16","report_id":"holdout2_007","text":"LSTM attains a test accuracy of 78.0% at epoch 6 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_007_s17","report_id":"holdout2_007","text":"Logistic Regression reaches 58.5% accuracy on Fashion-MNIST.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_007_s18","report_id":"holdout2_007","text":"The differences between the models are discussed in the next section.","page":1,"nearest_figure_id":"fig3"}]}