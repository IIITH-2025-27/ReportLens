entence_id":"holdout2_019_s15","report_id":"holdout2_019","text":"ViT-S scores 7.1 points higher on IMDB than on MNIST (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_019_s16","report_id":"holdout2_019","text":"On MNIST, ViT-S obtains a test accuracy of over 55%.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_019_s17","report_id":"holdout2_019","text":"On MNIST, ViT-S obtains a test accuracy of 62.5% (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_019_s18","report_id":"holdout2_019","text":"On IMDB, Random Forest obtains an accuracy of 74.8%.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_019_s19","report_id":"holdout2_019","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig3"}]}