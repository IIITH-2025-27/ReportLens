ST","Dataset","CNN","ResNet-50","CIFAR-10","IMDB","AGNews","SVHN","MNIST"],"y_span":90.64597791619039}],"sentences":[{"sentence_id":"holdout2_010_s0","report_id":"holdout2_010","text":"Lab Report: Comparing CNN architectures","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_010_s1","report_id":"holdout2_010","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_010_s2","report_id":"holdout2_010","text":"We trained each model for 30 epochs with a batch size of 128.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_010_s3","report_id":"holdout2_010","text":"The learning rate was set to 0.01 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_010_s4","report_id":"holdout2_010","text":"Figure 1 shows the test accuracy during training.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_010_s5","report_id":"holdout2_010","text":"As shown in Figure 1, at epoch 60, Baseline achieves 83.7% test accuracy.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_010_s6","report_id":"holdout2_010","text":"DistilBERT outperforms Baseline by 11.2 percentage points at epoch 20 (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_010_s7","report_id":"holdout2_010","text":"As shown in Figure 1, at epoch 20, DistilBERT achieves 74.5% test accuracy.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_010_s8","report_id":"holdout2_010","text":"Figure 2 shows the test accuracy by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_010_s9","report_id":"holdout2_010","text":"CNN reaches 100.8% test accuracy on SST-2.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_010_s10","report_id":"holdout2_010","text":"As shown in Figure 2, MLP outperforms VGG-16 by 5 percentage points on CIFAR-10.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_010_s11","report_id":"holdout2_010","text":"Figure 3 shows the test accuracy during training.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_010_s12","report_id":"holdout2_010","text":"VGG-16 reaches 69.1% test accuracy at epoch 7 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_010_s13","report_id":"holdout2_010","text":"Transformer outperforms Baseline by 3.1 percentage points at epoch 5.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_010_s14","report_id":"holdout2_010","text":"As shown in Figure 3, at epoch 4, VGG-16 achieves about 70% test accuracy.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_010_s15","report_id":"holdout2_010","text":"Figure 4 shows the validation accuracy by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_010_s16","report_id":"holdout2_010","text":"As shown in Figure 4, on SVHN, ResNet-50 obtains a validation accuracy of over 75%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_010_s17","report_id":"holdout2_010","text":"ResNet-50 achieves 74.3% validation accuracy on IMDB.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_010_s18","report_id":"holdout2_010","text":"On Fashion-MNIST, XGBoost obtains an accuracy of 56.4%.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_010_s19","report_id":"holdout2_010","text":"Overall, the results are in line with what we expected from the literature.","page":2,"nearest_figure_id":"fig4"}]}