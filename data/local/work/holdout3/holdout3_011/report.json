iT-S","SST-2","IMDB","SVHN","CIFAR-10","MNIST"],"y_span":100.22976117575023}],"sentences":[{"sentence_id":"holdout3_011_s0","report_id":"holdout3_011","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_011_s1","report_id":"holdout3_011","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_011_s2","report_id":"holdout3_011","text":"Each experiment was repeated 5 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_011_s3","report_id":"holdout3_011","text":"The learning rate was set to 0.001 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_011_s4","report_id":"holdout3_011","text":"Figure 1 shows the training loss.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_011_s5","report_id":"holdout3_011","text":"At epoch 13, the loss of GRU is over 0.7.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_011_s6","report_id":"holdout3_011","text":"As shown in Figure 1, GRU has a loss of 0.338 at epoch 5.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_011_s7","report_id":"holdout3_011","text":"At epoch 10, the loss of ViT-S is 1.613.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_011_s8","report_id":"holdout3_011","text":"ViT-S has a loss of -0.044 at epoch 4 (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_011_s9","report_id":"holdout3_011","text":"Figure 2 shows the f1 score by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_011_s10","report_id":"holdout3_011","text":"Transformer outperforms Baseline by 12.4 percentage points on MNIST.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_011_s11","report_id":"holdout3_011","text":"Transformer achieves 77.4% F1 score on SVHN.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_011_s12","report_id":"holdout3_011","text":"As shown in Figure 2, Transformer achieves 64.0% F1 score on CIFAR-10.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_011_s13","report_id":"holdout3_011","text":"Transformer reaches 76.4% F1 score on SST-2.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_011_s14","report_id":"holdout3_011","text":"Figure 3 shows the accuracy during training.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_011_s15","report_id":"holdout3_011","text":"At epoch 32, MobileNet achieves 79.5% accuracy.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_011_s16","report_id":"holdout3_011","text":"As shown in Figure 3, BERT-base outperforms GRU by 11.0 percentage points at epoch 4.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_011_s17","report_id":"holdout3_011","text":"Figure 4 shows the accuracy by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_011_s18","report_id":"holdout3_011","text":"As shown in Figure 4, MobileNet reaches 77.4% accuracy on SST-2.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_011_s19","report_id":"holdout3_011","text":"As shown in Figure 4, BERT-base outperforms MobileNet by 1.9 percentage points on CIFAR-10.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_011_s20","report_id":"holdout3_011","text":"ViT-S outperforms BERT-base by 32.8 percentage points on SST-2.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_011_s21","report_id":"holdout3_011","text":"BERT-base outperforms MobileNet by 52.2 percentage points on SVHN.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_011_s22","report_id":"holdout3_011","text":"The differences between the models are discussed in the next section.","page":1,"nearest_figure_id":"fig4"}]}