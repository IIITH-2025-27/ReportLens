":40.27173913043478}],"sentences":[{"sentence_id":"holdout3_015_s0","report_id":"holdout3_015","text":"Lab Report: Image classification experiments","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_015_s1","report_id":"holdout3_015","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_015_s2","report_id":"holdout3_015","text":"The learning rate was set to 0.001 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_015_s3","report_id":"holdout3_015","text":"The dataset was split into 70 percent training data and the rest for testing.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_015_s4","report_id":"holdout3_015","text":"Figure 1 shows the test accuracy by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_015_s5","report_id":"holdout3_015","text":"Baseline achieves 74.2% test accuracy on AG News.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_015_s6","report_id":"holdout3_015","text":"Baseline achieves 71.5% test accuracy on SST-2.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_015_s7","report_id":"holdout3_015","text":"BERT-base reaches 78% test accuracy on AG News (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_015_s8","report_id":"holdout3_015","text":"On MNIST, LSTM is 12.5 points better than GRU.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_015_s9","report_id":"holdout3_015","text":"Figure 2 shows the f1 score by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_015_s10","report_id":"holdout3_015","text":"Ours reaches over 70% F1 score on SST-2 (Figure 2).","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_015_s11","report_id":"holdout3_015","text":"On Fashion-MNIST, Ours is 8.5 points better than Baseline.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_015_s12","report_id":"holdout3_015","text":"Figure 3 shows the test accuracy during training.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_015_s13","report_id":"holdout3_015","text":"As shown in Figure 3, VGG-16 attains a test accuracy of 66.9% at epoch 8.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_015_s14","report_id":"holdout3_015","text":"VGG-16 attains a test accuracy of 78.8% at epoch 12.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_015_s15","report_id":"holdout3_015","text":"VGG-16 scores 1.5 points higher on 16 than on 12 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_015_s16","report_id":"holdout3_015","text":"VGG-16 attains a test accuracy of 59% at epoch 4.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_015_s17","report_id":"holdout3_015","text":"Figure 4 shows the accuracy during training.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_015_s18","report_id":"holdout3_015","text":"As shown in Figure 4, MobileNet outperforms GRU by 23.9 percentage points at epoch 3.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_015_s19","report_id":"holdout3_015","text":"MobileNet outperforms GRU by 9 percentage points at epoch 4.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_015_s20","report_id":"holdout3_015","text":"On STL-10, SVM obtains an accuracy of 79.1%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_015_s21","report_id":"holdout3_015","text":"Overall, the results are in line with what we expected from the literature.","page":1,"nearest_figure_id":"fig4"}]}