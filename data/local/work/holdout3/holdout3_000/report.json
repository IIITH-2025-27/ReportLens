:47.94111756459041}],"sentences":[{"sentence_id":"holdout3_000_s0","report_id":"holdout3_000","text":"Lab Report: Text classification with neural networks","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_000_s1","report_id":"holdout3_000","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_000_s2","report_id":"holdout3_000","text":"The learning rate was set to 0.0003 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_000_s3","report_id":"holdout3_000","text":"Each experiment was repeated 3 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_000_s4","report_id":"holdout3_000","text":"Figure 1 shows the test accuracy by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_000_s5","report_id":"holdout3_000","text":"On CIFAR-10, VGG-16 obtains a test accuracy of over 70%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_000_s6","report_id":"holdout3_000","text":"ResNet-50 reaches 63.2% test accuracy on Fashion-MNIST.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_000_s7","report_id":"holdout3_000","text":"Figure 2 shows the accuracy during training.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_000_s8","report_id":"holdout3_000","text":"As shown in Figure 2, Transformer outperforms ResNet-50 by 26.2 percentage points at epoch 35.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_000_s9","report_id":"holdout3_000","text":"As shown in Figure 2, at epoch 20, ViT-S achieves 71.0% accuracy.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_000_s10","report_id":"holdout3_000","text":"Figure 3 shows the accuracy during training.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_000_s11","report_id":"holdout3_000","text":"As shown in Figure 3, MLP outperforms Transformer by 8.7 percentage points at epoch 6.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_000_s12","report_id":"holdout3_000","text":"ViT-S attains a accuracy of about 90% at epoch 12 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_000_s13","report_id":"holdout3_000","text":"Figure 4 shows the accuracy during training.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_000_s14","report_id":"holdout3_000","text":"At epoch 2, MLP achieves 52% accuracy (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_000_s15","report_id":"holdout3_000","text":"As shown in Figure 4, CNN outperforms Ours by 32.9 percentage points at epoch 16.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_000_s16","report_id":"holdout3_000","text":"At epoch 10, CNN is 9.6 points better than Ours (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_000_s17","report_id":"holdout3_000","text":"Logistic Regression reaches 76.7% accuracy on STL-10.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_000_s18","report_id":"holdout3_000","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}