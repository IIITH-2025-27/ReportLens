","Transformer","SVHN","IMDB","MNIST|","ashion-MNIS","\"SST-2"],"y_span":100.29411764705884}],"sentences":[{"sentence_id":"holdout3_019_s0","report_id":"holdout3_019","text":"Lab Report: Model comparison on benchmarks","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_019_s1","report_id":"holdout3_019","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_019_s2","report_id":"holdout3_019","text":"All experiments were run on a single GPU with 16 GB of memory.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_019_s3","report_id":"holdout3_019","text":"We trained each model for 20 epochs with a batch size of 32.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_019_s4","report_id":"holdout3_019","text":"Figure 1 shows the validation accuracy by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout3_019_s5","report_id":"holdout3_019","text":"On IMDB, Ours obtains a validation accuracy of over 75% (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_019_s6","report_id":"holdout3_019","text":"Ours reaches 54.6% validation accuracy on SST-2 (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_019_s7","report_id":"holdout3_019","text":"On MNIST, ResNet-50 obtains a validation accuracy of 71.2%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_019_s8","report_id":"holdout3_019","text":"Transformer achieves 68.0% validation accuracy on MNIST.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_019_s9","report_id":"holdout3_019","text":"Figure 2 shows the validation accuracy of LSTM by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout3_019_s10","report_id":"holdout3_019","text":"On IMDB, LSTM obtains a validation accuracy of 44.3%.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_019_s11","report_id":"holdout3_019","text":"On IMDB, LSTM obtains a validation accuracy of 2.6%.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_019_s12","report_id":"holdout3_019","text":"LSTM scores 17.3 points higher on MNIST than on CIFAR-10.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_019_s13","report_id":"holdout3_019","text":"Figure 3 shows the accuracy by dataset.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout3_019_s14","report_id":"holdout3_019","text":"On MNIST, BERT-base is 4.3 points better than LSTM (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_019_s15","report_id":"holdout3_019","text":"As shown in Figure 3, BERT-base reaches 77.0% accuracy on AG News.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_019_s16","report_id":"holdout3_019","text":"BERT-base achieves 75.2% accuracy on AG News (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_019_s17","report_id":"holdout3_019","text":"On IMDB, LSTM obtains a accuracy of 55.9%.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_019_s18","report_id":"holdout3_019","text":"Figure 4 shows the test accuracy by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout3_019_s19","report_id":"holdout3_019","text":"ViT-S outperforms Transformer by 52.4 percentage points on SVHN (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_019_s20","report_id":"holdout3_019","text":"MLP achieves 71.0% test accuracy on SVHN.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_019_s21","report_id":"holdout3_019","text":"MLP reaches 87% test accuracy on MNIST (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_019_s22","report_id":"holdout3_019","text":"As shown in Figure 4, on SVHN, MLP obtains a test accuracy of 67.6%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout3_019_s23","report_id":"holdout3_019","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}