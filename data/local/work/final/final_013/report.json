Q Transformer","Me","SVHN","CIFAR-10","MNIST","AG News fashion-MNIST","Dataset"],"y_span":null}],"sentences":[{"sentence_id":"final_013_s0","report_id":"final_013","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"final_013_s1","report_id":"final_013","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"final_013_s2","report_id":"final_013","text":"The learning rate was set to 0.001 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"final_013_s3","report_id":"final_013","text":"The dataset was split into 70 percent training data and the rest for testing.","page":0,"nearest_figure_id":null},{"sentence_id":"final_013_s4","report_id":"final_013","text":"Figure 1 shows the test accuracy by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"final_013_s5","report_id":"final_013","text":"On IMDB, ResNet-50 obtains a test accuracy of over 60%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_013_s6","report_id":"final_013","text":"ResNet-18 reaches 67.7% test accuracy on MNIST (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_013_s7","report_id":"final_013","text":"Figure 2 shows the f1 score during training.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_013_s8","report_id":"final_013","text":"BERT-base attains a F1 score of 73.8% at epoch 8.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_013_s9","report_id":"final_013","text":"As shown in Figure 2, at epoch 12, ResNet-50 is 21.6 points better than VGG-16.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_013_s10","report_id":"final_013","text":"Figure 3 shows the f1 score by dataset.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_013_s11","report_id":"final_013","text":"MLP outperforms CNN by 7 percentage points on MNIST.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_013_s12","report_id":"final_013","text":"DistilBERT reaches 84.5% F1 score on SST-2.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_013_s13","report_id":"final_013","text":"MLP outperforms ResNet-18 by 11.7 percentage points on MNIST (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_013_s14","report_id":"final_013","text":"Figure 4 shows the validation accuracy by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_013_s15","report_id":"final_013","text":"ResNet-50 outperforms VGG-16 by 3.3 percentage points on AG News (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_013_s16","report_id":"final_013","text":"As shown in Figure 4, VGG-16 achieves 64% validation accuracy on MNIST.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_013_s17","report_id":"final_013","text":"ResNet-50 reaches 75.0% validation accuracy on CIFAR-10.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_013_s18","report_id":"final_013","text":"Overall, the results are in line with what we expected from the literature.","page":1,"nearest_figure_id":"fig4"}]}