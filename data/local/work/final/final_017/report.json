inal_017","text":"Lab Report: Comparing CNN architectures","page":0,"nearest_figure_id":null},{"sentence_id":"final_017_s1","report_id":"final_017","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"final_017_s2","report_id":"final_017","text":"We trained each model for 20 epochs with a batch size of 32.","page":0,"nearest_figure_id":null},{"sentence_id":"final_017_s3","report_id":"final_017","text":"The dataset was split into 80 percent training data and the rest for testing.","page":0,"nearest_figure_id":null},{"sentence_id":"final_017_s4","report_id":"final_017","text":"Figure 1 shows the training loss.","page":0,"nearest_figure_id":null},{"sentence_id":"final_017_s5","report_id":"final_017","text":"As shown in Figure 1, DistilBERT has a loss of 0.423 at epoch 5.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_017_s6","report_id":"final_017","text":"DistilBERT has a loss of 0.997 at epoch 2.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_017_s7","report_id":"final_017","text":"Figure 2 shows the accuracy during training.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_017_s8","report_id":"final_017","text":"At epoch 28, EfficientNet achieves 73.2% accuracy.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_017_s9","report_id":"final_017","text":"From epoch 22 to epoch 28, the accuracy of GRU improves by a relative 5.9%.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_017_s10","report_id":"final_017","text":"Figure 3 shows the accuracy by dataset.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"final_017_s11","report_id":"final_017","text":"MLP achieves 56.1% accuracy on IMDB.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_017_s12","report_id":"final_017","text":"On MNIST, CNN obtains a accuracy of 125.1%.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_017_s13","report_id":"final_017","text":"On MNIST, VGG-16 is 10.2 points better than MLP.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_017_s14","report_id":"final_017","text":"Figure 4 shows the validation accuracy during training.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_017_s15","report_id":"final_017","text":"At epoch 10, Transformer is 10.4 points better than Ours.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_017_s16","report_id":"final_017","text":"Transformer reaches 86.0% validation accuracy at epoch 50.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_017_s17","report_id":"final_017","text":"As shown in Figure 4, from epoch 30 to epoch 40, the validation accuracy of Transformer improves by a relative 15.4%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_017_s18","report_id":"final_017","text":"At epoch 50, Ours is 16.1 points better than EfficientNet.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_017_s19","report_id":"final_017","text":"On AG News, Logistic Regression obtains an accuracy of 80.6%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_017_s20","report_id":"final_017","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}