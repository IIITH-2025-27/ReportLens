tences":[{"sentence_id":"final_007_s0","report_id":"final_007","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"final_007_s1","report_id":"final_007","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"final_007_s2","report_id":"final_007","text":"We trained each model for 50 epochs with a batch size of 128.","page":0,"nearest_figure_id":null},{"sentence_id":"final_007_s3","report_id":"final_007","text":"The learning rate was set to 0.0003 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"final_007_s4","report_id":"final_007","text":"Figure 1 shows the test accuracy during training.","page":0,"nearest_figure_id":null},{"sentence_id":"final_007_s5","report_id":"final_007","text":"From epoch 9 to epoch 11, the test accuracy of MobileNet improves by a relative about 2%.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_007_s6","report_id":"final_007","text":"LSTM reaches 60.5% test accuracy at epoch 15.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_007_s7","report_id":"final_007","text":"Figure 2 shows the test accuracy by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_007_s8","report_id":"final_007","text":"On CIFAR-10, MLP obtains a test accuracy of 66%.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_007_s9","report_id":"final_007","text":"MLP achieves 79.0% test accuracy on MNIST.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_007_s10","report_id":"final_007","text":"Figure 3 shows the accuracy by dataset.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"final_007_s11","report_id":"final_007","text":"On SST-2, LSTM is 8.0 points better than VGG-16.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_007_s12","report_id":"final_007","text":"On CIFAR-10, VGG-16 obtains a accuracy of 63.6%.","page":1,"nearest_figure_id":"fig3"},{"se