es":[{"sentence_id":"final_014_s0","report_id":"final_014","text":"Lab Report: Comparing CNN architectures","page":0,"nearest_figure_id":null},{"sentence_id":"final_014_s1","report_id":"final_014","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"final_014_s2","report_id":"final_014","text":"We trained each model for 20 epochs with a batch size of 32.","page":0,"nearest_figure_id":null},{"sentence_id":"final_014_s3","report_id":"final_014","text":"Each experiment was repeated 3 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"final_014_s4","report_id":"final_014","text":"Figure 1 shows the training loss.","page":0,"nearest_figure_id":null},{"sentence_id":"final_014_s5","report_id":"final_014","text":"As shown in Figure 1, CNN has a loss of 0.644 at epoch 70.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_014_s6","report_id":"final_014","text":"CNN has a loss of 1.260 at epoch 10.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_014_s7","report_id":"final_014","text":"MobileNet has a loss of 0.765 at epoch 50 (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_014_s8","report_id":"final_014","text":"At epoch 60, the loss of MLP is over 0.3 (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_014_s9","report_id":"final_014","text":"Figure 2 shows the accuracy by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"final_014_s10","report_id":"final_014","text":"VGG-16 reaches 72.0% accuracy on SVHN (Figure 2).","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"final_014_s11","report_id":"final_014","text":"DistilBERT reaches 53.3% accuracy on AG News.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"final_014_s12","report_id":"final_014","text":"As shown in Figure 2, BERT-base achieves 71% accuracy on MNIST.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"final_014_s13","report_id":"final_014","text":"Figure 3 shows the f1 score during training.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"final_014_s14","report_id":"final_014","text":"Transformer attains a F1 score of 80% at epoch 35.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_014_s15","report_id":"final_014","text":"Transformer reaches about 80% F1 score at epoch 30.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_014_s16","report_id":"final_014","text":"Transformer reaches 78.0% F1 score at epoch 30.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_014_s17","report_id":"final_014","text":"Transformer scores 6.1 points higher on 35 than on 20.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_014_s18","report_id":"final_014","text":"Figure 4 shows the training loss.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"final_014_s19","report_id":"final_014","text":"CNN has a loss of 0.57 at epoch 14.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_014_s20","report_id":"final_014","text":"At epoch 34, the loss of EfficientNet is over 0.3 (Figure 4).","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_014_s21","report_id":"final_014","text":"As shown in Figure 4, ResNet-50 has a loss of 0.003 at epoch 12.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"final_014_s22","report_id":"final_014","text":"On AG News, XGBoost obtains an accuracy of 70.9%.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"final_014_s23","report_id":"final_014","text":"We note that the training was stable for all models.","page":2,"nearest_figure_id":"fig4"}]}