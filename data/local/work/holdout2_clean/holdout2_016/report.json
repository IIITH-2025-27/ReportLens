out2_016_s0","report_id":"holdout2_016","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_016_s1","report_id":"holdout2_016","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_016_s2","report_id":"holdout2_016","text":"The learning rate was set to 0.0003 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_016_s3","report_id":"holdout2_016","text":"Each experiment was repeated 5 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_016_s4","report_id":"holdout2_016","text":"Figure 1 shows the test accuracy of CNN by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout2_016_s5","report_id":"holdout2_016","text":"CNN scores 29.4 points higher on Fashion-MNIST than on AG News.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_016_s6","report_id":"holdout2_016","text":"As shown in Figure 1, CNN reaches over 80% test accuracy on Fashion-MNIST.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_016_s7","report_id":"holdout2_016","text":"CNN scores 39.3 points higher on Fashion-MNIST than on AG News (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_016_s8","report_id":"holdout2_016","text":"Figure 2 shows the accuracy of DistilBERT by dataset.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout2_016_s9","report_id":"holdout2_016","text":"DistilBERT achieves 86% accuracy on Fashion-MNIST (Figure 2).","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_016_s10","report_id":"holdout2_016","text":"DistilBERT reaches 84.4% accuracy on IMDB.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_016_s11","report_id":"holdout2_016","text":"DistilBERT scores 29.3 points higher on IMDB than on MNIST.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_016_s12","report_id":"holdout2_016","text":"As shown in Figure 2, DistilBERT reaches 86% accuracy on Fashion-MNIST.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_016_s13","report_id":"holdout2_016","text":"Figure 3 shows the training loss.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout2_016_s14","report_id":"holdout2_016","text":"DistilBERT has a loss of 0.192 at epoch 16 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_016_s15","report_id":"holdout2_016","text":"ResNet-18 has a loss of 0.266 at epoch 18 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_016_s16","report_id":"holdout2_016","text":"As shown in Figure 3, ResNet-18 has a loss of 0.291 at epoch 18.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_016_s17","report_id":"holdout2_016","text":"Figure 4 shows the accuracy by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout2_016_s18","report_id":"holdout2_016","text":"On AG News, ResNet-50 is 28.4 points better than CNN.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_016_s19","report_id":"holdout2_016","text":"CNN reaches 65.7% accuracy on SST-2.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_016_s20","report_id":"holdout2_016","text":"On IMDB, CNN is 7.2 points better than MobileNet.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_016_s21","report_id":"holdout2_016","text":"ViT-S outperforms ResNet-50 by about 2 percentage points on IMDB.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_016_s22","report_id":"holdout2_016","text":"On MNIST, SVM obtains an accuracy of 57.1%.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"holdout2_016_s23","report_id":"holdout2_016","text":"The differences between the models are discussed in the next section.","page":2,"nearest_figure_id":"fig4"}]}