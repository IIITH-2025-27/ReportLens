,"sentences":[{"sentence_id":"v3feat_002_s0","report_id":"v3feat_002","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_002_s1","report_id":"v3feat_002","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_002_s2","report_id":"v3feat_002","text":"We trained each model for 30 epochs with a batch size of 32.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_002_s3","report_id":"v3feat_002","text":"Each experiment was repeated 5 times with different random seeds.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_002_s4","report_id":"v3feat_002","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_002_s5","report_id":"v3feat_002","text":"As shown in Figure 1, at epoch 8, Baseline is 9.2 points better than ResNet-50.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_002_s6","report_id":"v3feat_002","text":"As shown in Figure 1, at epoch 2, Baseline is 21.0 points better than ResNet-50.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_002_s7","report_id":"v3feat_002","text":"Baseline attains a F1 score of 55.6% at epoch 2.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_002_s8","report_id":"v3feat_002","text":"At epoch 10, MobileNet reaches its maximum F1 score of 71.4%.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_002_s9","report_id":"v3feat_002","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_002_s10","report_id":"v3feat_002","text":"As shown in Figure 2, from epoch 8 to epoch 10, the F1 score of MLP improves by a relative 8.4%.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_002_s11","report_id":"v3feat_002","text":"MLP reaches 59.3% F1 score at epoch 2.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_002_s12","report_id":"v3feat_002","text":"Figure 3 shows the results of this experiment.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_002_s13","report_id":"v3feat_002","text":"Baseline has a loss of 0.552 at epoch 5 (Figure 3(a)).","page":1,"nearest_figure_id":"fig3a","figure_id":null},{"sentence_id":"v3feat_002_s14","report_id":"v3feat_002","text":"LSTM has a loss of about 0.8 at epoch 2 (Figure 3(a)).","page":1,"nearest_figure_id":"fig3a","figure_id":null},{"sentence_id":"v3feat_002_s15","report_id":"v3feat_002","text":"At epoch 6, the loss of LSTM is 0.560.","page":1,"nearest_figure_id":"fig3a","figure_id":null},{"sentence_id":"v3feat_002_s16","report_id":"v3feat_002","text":"The loss of LSTM reaches its highest value of 0.844 at epoch 2.","page":1,"nearest_figure_id":"fig3a","figure_id":null},{"sentence_id":"v3feat_002_s17","report_id":"v3feat_002","text":"At epoch 25, the loss of MLP is between -1 and 0 (Figure 3).","page":1,"nearest_figure_id":"fig3a","figure_id":null},{"sentence_id":"v3feat_002_s18","report_id":"v3feat_002","text":"At epoch 35, the loss of Transformer is between 1 and 2.","page":1,"nearest_figure_id":"fig3a","figure_id":null},{"sentence_id":"v3feat_002_s19","report_id":"v3feat_002","text":"On Fashion-MNIST, SVM obtains an accuracy of 91.1%.","page":1,"nearest_figure_id":"fig3a","figure_id":null},{"sentence_id":"v3feat_002_s20","report_id":"v3feat_002","text":"Overall, the results are in line with what we expected from the literature.","page":1,"nearest_figure_id":"fig3a","figure_id":null}]}