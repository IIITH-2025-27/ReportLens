"MNIST","SST-2"],"y_span":93.39622641509436,"panel":null,"y_range":[-0.09433962264154161,93.30188679245282],"flags":[]},{"figure_id":"fig4","report_id":"v3feat_015","image_path":"data/local/work/v3feat/v3feat_015/p2_x34.png","caption":"Accuracy by dataset (text) for the models in this experiment.","number":4,"chart_type":"grouped_bar","page":2,"text_lines":["dataset (text)","Accuracy by","100","80","60","ViT-S","Ge","Ge","GRU","Mam","Ours","40","20","SVHN","CIFAR-10","IMDB","Dataset","VIT-S","GRU","Ours","SVHN","CIFAR-10","IMDB"],"y_span":100.4030159880013,"panel":null,"y_range":[-0.20140596463660643,100.2016100233647],"flags":[]}],"sentences":[{"sentence_id":"v3feat_015_s0","report_id":"v3feat_015","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_015_s1","report_id":"v3feat_015","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_015_s2","report_id":"v3feat_015","text":"Each experiment was repeated 3 times with different random seeds.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_015_s3","report_id":"v3feat_015","text":"All experiments were run on a single GPU with 16 GB of memory.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_015_s4","report_id":"v3feat_015","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_015_s5","report_id":"v3feat_015","text":"MLP reaches 72.7% validation accuracy on IMDB (Figure 1).","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_015_s6","report_id":"v3feat_015","text":"MLP scores 15.8 points higher on Fashion-MNIST than on IMDB (Figure 1).","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_015_s7","report_id":"v3feat_015","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_015_s8","report_id":"v3feat_015","text":"As shown in Figure 2(a), MobileNet reaches 62.2% test accuracy on Fashion-MNIST.","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s9","report_id":"v3feat_015","text":"MobileNet reaches 70.5% test accuracy on MNIST.","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s10","report_id":"v3feat_015","text":"MobileNet achieves 67.1% test accuracy on CIFAR-10.","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s11","report_id":"v3feat_015","text":"At epoch 10, the loss of BERT-base is 1.059 (Figure 2).","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s12","report_id":"v3feat_015","text":"At epoch 40, the loss of ViT-S is 0.695.","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s13","report_id":"v3feat_015","text":"ViT-S has a loss of 0.598 at epoch 60.","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s14","report_id":"v3feat_015","text":"The loss of ViT-S reaches its highest value of 1.653 at epoch 10.","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s15","report_id":"v3feat_015","text":"Figure 3 shows the results of this experiment.","page":1,"nearest_figure_id":"fig2a","figure_id":null},{"sentence_id":"v3feat_015_s16","report_id":"v3feat_015","text":"On Fashion-MNIST, ViT-S obtains a accuracy of 93.6%.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_015_s17","report_id":"v3feat_015","text":"GRU scores 14.0 points higher on CIFAR-10 than on SST-2.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_015_s18","report_id":"v3feat_015","text":"Figure 4 shows the results of this experiment.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_015_s19","report_id":"v3feat_015","text":"As shown in Figure 1, Ours outperforms GRU by 12.1 percentage points on IMDB.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_015_s20","report_id":"v3feat_015","text":"As shown in Figure 4, GRU reaches 67.8% accuracy on CIFAR-10.","page":2,"nearest_figure_id":"fig4","figure_id":null},{"sentence_id":"v3feat_015_s21","report_id":"v3feat_015","text":"Overall, the results are in line with what we expected from the literature.","page":2,"nearest_figure_id":"fig4","figure_id":null}]}