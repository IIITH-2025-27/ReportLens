arest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_022_s6","report_id":"v3feat_022","text":"LSTM scores 5.4 points higher on SVHN than on IMDB.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_022_s7","report_id":"v3feat_022","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_022_s8","report_id":"v3feat_022","text":"EfficientNet achieves 81% F1 score on CIFAR-10.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_022_s9","report_id":"v3feat_022","text":"As shown in Figure 2, EfficientNet achieves 56.1% F1 score on IMDB.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_022_s10","report_id":"v3feat_022","text":"On Fashion-MNIST, Random Forest obtains an accuracy of 76.4%.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_022_s11","report_id":"v3feat_022","text":"Overall, the results are in line with what we expected from the literature.","page":0,"nearest_figure_id":null,"figure_id":null}]}