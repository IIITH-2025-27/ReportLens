rs","VGG-16","ResNet-18","MNIST SST-2 Dataset","0","20","40","60","80","F1 score (%)","F1 score of Ours by dataset","MNIST","SST-2"],"y_span":96.70489332276662,"panel":"b","y_range":[-0.3008406756483879,96.40405264711823],"flags":["vector"]},{"figure_id":"fig2","report_id":"v3feat_010","image_path":"data/local/work/v3feat/v3feat_010/p0_vec1.png","caption":"F1 score of EfficientNet by dataset. EfficientNet achieves 110.6% F1 score on IMDB.","number":2,"chart_type":"bar","page":0,"text_lines":["Fl score","of EfficientNet by","dataset","100","80","oS","60","40","20","AG News","IMDB","Dataset","AG News IMDB","Dataset","0","20","40","60","80","100","F1 score (%)","F1 score of EfficientNet by dataset","AGNews","IMDB"],"y_span":100.3996069380096,"panel":null,"y_range":[-0.2077861143959865,100.19182082361361],"flags":["vector"]}],"sentences":[{"sentence_id":"v3feat_010_s0","report_id":"v3feat_010","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_010_s1","report_id":"v3feat_010","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_010_s2","report_id":"v3feat_010","text":"The learning rate was set to 0.01 with the Adam optimizer.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_010_s3","report_id":"v3feat_010","text":"The dataset was split into 80 percent training data and the rest for testing.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_010_s4","report_id":"v3feat_010","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_010_s5","report_id":"v3feat_010","text":"ViT-S achieves 58.6% validation accuracy on CIFAR-10, while ResNet-18 obtains 81.4% validation accuracy on MNIST.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_010_s6","report_id":"v3feat_010","text":"As shown in Figure 1(b), on SST-2, Ours obtains a F1 score of between 79% and 86%.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_010_s7","report_id":"v3feat_010","text":"Ours scores 25.7 points higher on SST-2 than on MNIST (Figure 1(b)).","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_010_s8","report_id":"v3feat_010","text":"Ours achieves 54.0% F1 score on MNIST (Figure 1(b)).","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_010_s9","report_id":"v3feat_010","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_010_s10","report_id":"v3feat_010","text":"EfficientNet achieves between 93% and 99% F1 score on AG News.","page":0,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_010_s11","report_id":"v3feat_010","text":"EffNet scores 0.9 points higher on AG News than on IMDB (Figure 2).","page":0,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_010_s12","report_id":"v3feat_010","text":"Figure 3 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_010_s13","report_id":"v3feat_010","text":"VGG16 reaches 105.7% validation accuracy on IMDB.","page":0,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_010_s14","report_id":"v3feat_010","text":"VGG-16 achieves 60.3% validation accuracy on AG News.","page":0,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_010_s15","report_id":"v3feat_010","text":"VGG16 achieves about 60% validation accuracy on AG News (Figure 3).","page":0,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_010_s16","report_id":"v3feat_010","text":"Overall, the results are in line with what we expected from the literature.","page":0,"nearest_figure_id":"fig3","figure_id":null}]}