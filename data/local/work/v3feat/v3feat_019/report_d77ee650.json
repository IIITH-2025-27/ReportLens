izer.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_019_s3","report_id":"v3feat_019","text":"All experiments were run on a single GPU with 24 GB of memory.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_019_s4","report_id":"v3feat_019","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_019_s5","report_id":"v3feat_019","text":"MobileNet achieves 87.2% F1 score on IMDB.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_019_s6","report_id":"v3feat_019","text":"Baseline outperforms ViT-S by 3 percentage points on SST-2.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_019_s7","report_id":"v3feat_019","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_019_s8","report_id":"v3feat_019","text":"MobileNet attains a validation accuracy of 88% at epoch 12 (Figure 2).","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_019_s9","report_id":"v3feat_019","text":"ResNet-18 attains a validation accuracy of 79.5% at epoch 8.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_019_s10","report_id":"v3feat_019","text":"As shown in Figure 2, ViT-S attains a validation accuracy of about 80% at epoch 8.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_019_s11","report_id":"v3feat_019","text":"Random Forest reaches 86.5% accuracy on Tiny-ImageNet.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_019_s12","report_id":"v3feat_019","text":"Overall, the results are in line with what we expected from the literature.","page":1,"nearest_figure_id":"fig2","figure_id":null}]}