,"IMDB"],"y_span":1.0005500530017966,"panel":null,"y_range":[-0.0013219485718662938,0.9992281044299303],"flags":["vector"]}],"sentences":[{"sentence_id":"v3feat_029_s0","report_id":"v3feat_029","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_029_s1","report_id":"v3feat_029","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_029_s2","report_id":"v3feat_029","text":"The dataset was split into 80 percent training data and the rest for testing.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_029_s3","report_id":"v3feat_029","text":"We trained each model for 50 epochs with a batch size of 32.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_029_s4","report_id":"v3feat_029","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_029_s5","report_id":"v3feat_029","text":"As shown in Figure 1, from epoch 8 to epoch 12, the F1 score of Ours improves by a relative 1.5%.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_029_s6","report_id":"v3feat_029","text":"Ours reaches 77.0% F1 score at epoch 8 and 75% at epoch 4.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_029_s7","report_id":"v3feat_029","text":"The F1 score of Ours reaches its highest value of 77.1% at epoch 6.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_029_s8","report_id":"v3feat_029","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_029_s9","report_id":"v3feat_029","text":"As shown in Figure 2, EfficientNet attains a F1 score of 78.9% at epoch 25.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_029_s10","report_id":"v3feat_029","text":"Transformer reaches 60.9% F1 score at epoch 25 (Figure 2).","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_029_s11","report_id":"v3feat_029","text":"At epoch 30, the loss of EfficientNet is 0.450.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_029_s12","report_id":"v3feat_029","text":"Figure 3 shows the results of this experiment.","page":1,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_029_s13","report_id":"v3feat_029","text":"BERT-base reaches 59.8% test accuracy on IMDB.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_029_s14","report_id":"v3feat_029","text":"As shown in Figure 3, BERT-base reaches 57.7% test accuracy on IMDB.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_029_s15","report_id":"v3feat_029","text":"As shown in Figure 3, BERT-base achieves 55% test accuracy on SVHN.","page":1,"nearest_figure_id":"fig3","figure_id":null},{"sentence_id":"v3feat_029_s16","report_id":"v3feat_029","text":"Overall, the results are in line with what we expected from the literature.","page":1,"nearest_figure_id":"fig3","figure_id":null}]}