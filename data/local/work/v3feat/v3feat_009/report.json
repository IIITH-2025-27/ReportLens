{"report_id":"v3feat_009","pdf_path":"data/local/generated/v3feat/v3feat_009/report.pdf","figures":[{"figure_id":"fig1","report_id":"v3feat_009","image_path":"data/local/work/v3feat/v3feat_009/p0_x11.png","caption":"(a) Accuracy of MLP by dataset (b) Validation accuracy during training","number":1,"chart_type":"bar","page":0,"text_lines":["Accuracy of MLP by dataset","Validation accuracy during training","100","80","80","75","=","_—","60","—e","GRU","70","Transformer","—t—","ResNet-18","40","65","20","60","MNIST","AG News","SST-2Fashion-MNISTIMDB","1","2","3","4","5","6","7","8","9","Dataset","Epoch","GRU","Transformer","ResNet-18","-2","-","1","2","3","5","6","7","8","9"],"y_span":100.20201291439702,"panel":null,"y_range":null,"flags":[]},{"figure_id":"fig2","report_id":"v3feat_009","image_path":"data/local/work/v3feat/v3feat_009/p0_x19.png","caption":"Validation accuracy during training","number":2,"chart_type":"line","page":0,"text_lines":["Validation accuracy","during training","62","alee YITS","2.00","66","&","1.75","G4","1.50","62","GO","1.25 9","53","1.00","3","sc","0.75","54","0.50","2","Epoch","VIT-S","1","2","3","5"],"y_span":15.706904376652595,"panel":null,"y_range":null,"flags":[]}],"sentences":[{"sentence_id":"v3feat_009_s0","report_id":"v3feat_009","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_009_s1","report_id":"v3feat_009","text":"Overall, the results are in line with what we expected from the literature.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_009_s2","report_id":"v3feat_009","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_009_s3","report_id":"v3feat_009","text":"All experiments were run on a single GPU with 24 GB of memory.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_009_s4","report_id":"v3feat_009","text":"The dataset was split into 70 percent training data and the rest for testing.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_009_s5","report_id":"v3feat_009","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_009_s6","report_id":"v3feat_009","text":"MLP achieves 85.2% accuracy on MNIST, while MLP obtains 64.6% accuracy on AG News.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_009_s7","report_id":"v3feat_009","text":"MLP has an error rate of 32.4% on SST-2.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_009_s8","report_id":"v3feat_009","text":"Transformer reaches 72% validation accuracy at epoch 7.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_009_s9","report_id":"v3feat_009","text":"As shown in Figure 1(b), ResNet-18 outperforms GRU by 8.3 percentage points at epoch 4.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_009_s10","report_id":"v3feat_009","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1","figure_id":null},{"sentence_id":"v3feat_009_s11","report_id":"v3feat_009","text":"As shown in Figure 2, ViT-S reaches 53.2% validation accuracy at epoch 1.","page":0,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_009_s12","report_id":"v3feat_009","text":"ViT-S reaches about 70% validation accuracy at epoch 4 (Figure 2).","page":0,"nearest_figure_id":"fig2","figure_id":null},{"sentence_id":"v3feat_009_s13","report_id":"v3feat_009","text":"At epoch 4, the loss of ViT-S is 0.559.","page":0,"nearest_figure_id":"fig2","figure_id":null}]}