ore of ResNet-50 by dataset","MNIST","SST-2","Fashion-MNIST"],"y_span":29.982942470925643,"panel":null,"y_range":[51.36287553227687,81.34581800320251],"flags":["vector","unsupported:box"]}],"sentences":[{"sentence_id":"v3feat_025_s0","report_id":"v3feat_025","text":"Lab Report: Model comparison","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s1","report_id":"v3feat_025","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s2","report_id":"v3feat_025","text":"The dataset was split into 80 percent training data and the rest for testing.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s3","report_id":"v3feat_025","text":"We trained each model for 20 epochs with a batch size of 32.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s4","report_id":"v3feat_025","text":"Figure 1 shows the results of this experiment.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s5","report_id":"v3feat_025","text":"Transformer achieves 64% test accuracy on CIFAR-10, while Transformer obtains 63.8% test accuracy on CIFAR-10.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_025_s6","report_id":"v3feat_025","text":"Transformer has an error rate of 45.2% on IMDB.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_025_s7","report_id":"v3feat_025","text":"As shown in Figure 1(b), on IMDB, VGG16 obtains a F1 score of 122.7%.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_025_s8","report_id":"v3feat_025","text":"VGG-16 reaches between 84% and 91% F1 score on AG News.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_025_s9","report_id":"v3feat_025","text":"Figure 2 shows the results of this experiment.","page":0,"nearest_figure_id":"fig1a","figure_id":null},{"sentence_id":"v3feat_025_s10","report_id":"v3feat_025","text":"ResNet-50 reaches 83.0% F1 score on Fashion-MNIST.","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s11","report_id":"v3feat_025","text":"ResNet-50 scores 9.4 points higher on MNIST than on SST-2 (Figure 2).","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s12","report_id":"v3feat_025","text":"ResNet-50 scores 12.9 points higher on Fashion-MNIST than on MNIST (Figure 2).","page":0,"nearest_figure_id":null,"figure_id":null},{"sentence_id":"v3feat_025_s13","report_id":"v3feat_025","text":"Overall, the results are in line with what we expected from the literature.","page":0,"nearest_figure_id":null,"figure_id":null}]}