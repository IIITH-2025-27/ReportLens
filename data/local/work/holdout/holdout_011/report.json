"sentences":[{"sentence_id":"holdout_011_s0","report_id":"holdout_011","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"holdout_011_s1","report_id":"holdout_011","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout_011_s2","report_id":"holdout_011","text":"All experiments were run on a single GPU with 12 GB of memory.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout_011_s3","report_id":"holdout_011","text":"The learning rate was set to 0.001 with the Adam optimizer.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout_011_s4","report_id":"holdout_011","text":"Figure 1 shows the accuracy during training.","page":0,"nearest_figure_id":null},{"sentence_id":"holdout_011_s5","report_id":"holdout_011","text":"At epoch 5, MobileNet achieves 81.3% accuracy.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout_011_s6","report_id":"holdout_011","text":"MLP reaches over 55% accuracy at epoch 2.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout_011_s7","report_id":"holdout_011","text":"As shown in Figure 1, MobileNet reaches over 80% accuracy at epoch 5.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout_011_s8","report_id":"holdout_011","text":"At epoch 4, BERT-base is 6.7 points better than MobileNet.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout_011_s9","report_id":"holdout_011","text":"Figure 2 shows the f1 score during training.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"holdout_011_s10","report_id":"holdout_011","text":"As shown in Figure 2, Ours reaches about 70% F1 score at epoch 34.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout_011_s11","report_id":"holdout_011","text":"At epoch 24, ViT-S achieves 93.5% F1 score.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout_011_s12","report_id":"holdout_011","text":"At epoch 28, MobileNet achieves 70.0% F1 score.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout_011_s13","report_id":"holdout_011","text":"Figure 3 shows the training loss.","page":1,"nearest_figure_id":"fig2"},{"sentence_id":"holdout_011_s14","report_id":"holdout_011","text":"VGG-16 has a loss of 1.545 at epoch 8.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout_011_s15","report_id":"holdout_011","text":"At epoch 14, the loss of CNN is 1.470 (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout_011_s16","report_id":"holdout_011","text":"CNN has a loss of 0.371 at epoch 30.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout_011_s17","report_id":"holdout_011","text":"At epoch 14, the loss of EfficientNet is 0.990.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout_011_s18","report_id":"holdout_011","text":"Figure 4 shows the test accuracy during training.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"holdout_011_s19","report_id":"holdout_011","text":"As shown in Figure 4, from epoch 10 to epoch 20, the test accuracy of BERT-base improves by a relative 19.1%.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"holdout_011_s20","report_id":"holdout_011","text":"As shown in Figure 4, at epoch 20, MobileNet is 3.3 points better than BERT-base.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"holdout_011_s21","report_id":"holdout_011","text":"From epoch 15 to epoch 25, the test accuracy of CNN improves by a relative 11.2%.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"holdout_011_s22","report_id":"holdout_011","text":"Random Forest reaches 70.2% accuracy on SVHN.","page":2,"nearest_figure_id":"fig4"},{"sentence_id":"holdout_011_s23","report_id":"holdout_011","text":"We note that the training was stable for all models.","page":2,"nearest_figure_id":"fig4"}]}