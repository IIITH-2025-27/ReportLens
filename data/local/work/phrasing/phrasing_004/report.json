istilBERT","MLP","ViT-S","2","10","14","18","22","26","30"],"y_span":2.004464285714286}],"sentences":[{"sentence_id":"phrasing_004_s0","report_id":"phrasing_004","text":"Lab Report: Comparing CNN architectures","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_004_s1","report_id":"phrasing_004","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_004_s2","report_id":"phrasing_004","text":"All experiments were run on a single GPU with 16 GB of memory.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_004_s3","report_id":"phrasing_004","text":"Each experiment was repeated 3 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_004_s4","report_id":"phrasing_004","text":"Figure 1 shows the accuracy of Transformer by dataset.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_004_s5","report_id":"phrasing_004","text":"On IMDB, Transformer obtains a accuracy of 69.9% (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"phrasing_004_s6","report_id":"phrasing_004","text":"Transformer posts over 55% accuracy when tested on AG News.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"phrasing_004_s7","report_id":"phrasing_004","text":"Figure 2 shows the training loss.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"phrasing_004_s8","report_id":"phrasing_004","text":"Epoch 12 sees BERT-base post a loss of 0.867.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_004_s9","report_id":"phrasing_004","text":"As shown in Figure 2, BERT-base has a loss of 1.096 at epoch 8.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_004_s10","report_id":"phrasing_004","text":"As shown in Figure 2, By epoch 12, the loss of EfficientNet stands at 0.577.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_004_s11","report_id":"phrasing_004","text":"Epoch 30 sees BERT-base post a loss of 0.435.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_004_s12","report_id":"phrasing_004","text":"Figure 3 shows the validation accuracy by dataset.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_004_s13","report_id":"phrasing_004","text":"Evaluated on SST-2, VGG-16 comes in at about 60% validation accuracy.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_004_s14","report_id":"phrasing_004","text":"GRU posts 98.6% validation accuracy when tested on AG News.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_004_s15","report_id":"phrasing_004","text":"On SST-2, VGG-16 obtains a validation accuracy of 64.2%.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_004_s16","report_id":"phrasing_004","text":"As shown in Figure 3, MLP posts 65.4% validation accuracy when tested on MNIST.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_004_s17","report_id":"phrasing_004","text":"Figure 4 shows the training loss.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_004_s18","report_id":"phrasing_004","text":"By epoch 18, the loss of MobileNet stands at over 0.7.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_004_s19","report_id":"phrasing_004","text":"As shown in Figure 4, Epoch 8 sees MobileNet post a loss of 1.05.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_004_s20","report_id":"phrasing_004","text":"DistilBERT has a loss of 1.040 at epoch 18.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_004_s21","report_id":"phrasing_004","text":"On MNIST, XGBoost obtains an accuracy of 53.4%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_004_s22","report_id":"phrasing_004","text":"The differences between the models are discussed in the next section.","page":1,"nearest_figure_id":"fig4"}]}