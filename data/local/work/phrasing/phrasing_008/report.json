2298500379}],"sentences":[{"sentence_id":"phrasing_008_s0","report_id":"phrasing_008","text":"Lab Report: Training dynamics of deep models","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_008_s1","report_id":"phrasing_008","text":"In this report we compare several models on standard benchmarks.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_008_s2","report_id":"phrasing_008","text":"Each experiment was repeated 5 times with different random seeds.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_008_s3","report_id":"phrasing_008","text":"We trained each model for 100 epochs with a batch size of 64.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_008_s4","report_id":"phrasing_008","text":"Figure 1 shows the validation accuracy during training.","page":0,"nearest_figure_id":null},{"sentence_id":"phrasing_008_s5","report_id":"phrasing_008","text":"At epoch 2, ResNet-18 leads CNN by 12.9 points (Figure 1).","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"phrasing_008_s6","report_id":"phrasing_008","text":"As shown in Figure 1, at epoch 4, EfficientNet achieves 82.9% validation accuracy.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"phrasing_008_s7","report_id":"phrasing_008","text":"At epoch 20, EfficientNet achieves 80.1% validation accuracy.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"phrasing_008_s8","report_id":"phrasing_008","text":"Figure 2 shows the training loss.","page":0,"nearest_figure_id":"fig1"},{"sentence_id":"phrasing_008_s9","report_id":"phrasing_008","text":"Epoch 3 sees ResNet-18 post a loss of 1.334.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_008_s10","report_id":"phrasing_008","text":"Epoch 18 sees ResNet-18 post a loss of 0.613.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_008_s11","report_id":"phrasing_008","text":"By epoch 9, the loss of ResNet-18 stands at 0.694 (Figure 2).","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_008_s12","report_id":"phrasing_008","text":"Figure 3 shows the test accuracy during training.","page":0,"nearest_figure_id":"fig2"},{"sentence_id":"phrasing_008_s13","report_id":"phrasing_008","text":"Baseline attains a test accuracy of 56.6% at epoch 50.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_008_s14","report_id":"phrasing_008","text":"Epoch 10 sees BERT-base post a test accuracy of 60.6% (Figure 3).","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_008_s15","report_id":"phrasing_008","text":"Figure 4 shows the test accuracy by dataset.","page":1,"nearest_figure_id":"fig3"},{"sentence_id":"phrasing_008_s16","report_id":"phrasing_008","text":"ResNet-50 beats VGG-16 by 1.4 points on IMDB.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_008_s17","report_id":"phrasing_008","text":"As shown in Figure 4, on Fashion-MNIST, VGG-16 leads Transformer by 10 points.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_008_s18","report_id":"phrasing_008","text":"MobileNet reaches 55.0% test accuracy on CIFAR-10.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_008_s19","report_id":"phrasing_008","text":"On STL-10, SVM obtains an accuracy of 88.9%.","page":1,"nearest_figure_id":"fig4"},{"sentence_id":"phrasing_008_s20","report_id":"phrasing_008","text":"We note that the training was stable for all models.","page":1,"nearest_figure_id":"fig4"}]}