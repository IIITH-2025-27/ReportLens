# Optional. Anything not set here is read from web/backend/.env, so by default the lite app uses the same
# database (and the same verifier settings) as the full web app. Its tables all end in _v2.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Where uploaded PDFs and extracted figures are kept (relative to web_lite/backend unless absolute)
LITE_STORAGE_DIR=storage
# Comma-separated origins allowed to call the API
LITE_CORS_ORIGINS=http://localhost:5174
# Most verifier runs that may wait or run at once (the app is open to everyone)
LITE_MAX_QUEUED_RUNS=10

# Verifier settings, shared with web/backend unless set here. The config path is relative to the repository root.
# VERIFIER_CONFIG=configs/exp/local_real.yaml
# VERIFIER_POLICY=informed
# VERIFIER_PARSER=agent
# CCV_REMOTE_URL=https://example.trycloudflare.com
# CCV_REMOTE_KEY=the SERVER_KEY the model server was started with
